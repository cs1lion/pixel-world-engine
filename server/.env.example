# 本地跑意图实验用的密钥文件。
#
#   cp .env.example .env   然后填进你自己的值
#
# `.env` 已被仓库根 `.gitignore` 挡住（规则：`.env` 与 `.env.*`），
# 不会被提交。**不要**把真 Key 写进这个 `.env.example`——它是要提交的。
#
# 跑：cd server && python scripts/intent_experiment.py

# 必填。用 OpenAI 兼容的 chat/completions 接口；StepFun、DeepSeek、
# 自建网关都是这个形状。
LLM_API_KEY=

# 接口地址。省略时默认 https://api.openai.com/v1
LLM_BASE_URL=

# 模型名。省略时默认 gpt-4o-mini
LLM_MODEL=

# 单次调用的超时（秒）。省略时默认 8。
# 实验要跑 55 条，调太大会把总时长拖得很长。
# （2026-10-28：这一行原来写「51 条」。55 = LEGAL 26 + OUT_OF_BOUNDS 12 +
# CHITCHAT 10 + AMBIGUOUS 7，数法见 `scripts/intent_experiment.py` 里那四个列表。
# 用例会增减，别照抄这个数。）
LLM_TIMEOUT_SECONDS=
