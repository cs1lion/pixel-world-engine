#!/bin/sh
# 本地强制检查（push 前）。这里有两道，互不替代：
#
#   1) main 保护：拒绝直接 push 到 refs/heads/main（含删除 main）。
#      背景：GitHub 的分支保护 API 在本仓当前凭据下返回 404，远端规则暂时上不了，
#      所以这条边界放在本地：只要装了 core.hooksPath=.githooks，任何一次 push 前
#      Git 都会把待推引用交给这个脚本，目标分支是 main 就拦下。
#      豁免：PWE_ALLOW_PUSH_MAIN=1 —— **只跳过这一条**，下面的第 2 道照跑。
#
#   2) 大文件检查：拒绝新增 blob ≥ PWE_PREPUSH_MAX_BLOB_BYTES（默认 5 MB）。
#      理由：证据图/快照进历史后删不掉，只能重写历史；这类东西在本仓反复出现。
#      只查本次推送新增的对象（rev-list <remote_sha>..<local_sha>），不查全库。
#      放宽：PWE_PREPUSH_MAX_BLOB_BYTES=<字节数> git push ...（只影响这一次）。
#      **每次放宽必须在本次推送的提交说明里写明：放宽到多少、为什么、谁批准的。**
#      钩子看不到提交说明，这句只能靠 review 核；不写就等于这次放宽没有痕迹。
#
# 安装：git config core.hooksPath .githooks
# 自检：npm run check:hooks（含两条路径的反向用例：有豁免 / 无豁免）
# 注意：--no-verify 会跳过整条 pre-push，两道检查都不跑（见 docs/RESUME.md）
#
# pre-push 的 stdin 每行是：<local ref> <local sha> <remote ref> <remote sha>
# 删除远端分支时 local ref 是 (delete)；为防手滑，删除 main 同样拦下。

protected="refs/heads/main"
zero="0000000000000000000000000000000000000000"
allow_main="${PWE_ALLOW_PUSH_MAIN:-0}"
max_blob="${PWE_PREPUSH_MAX_BLOB_BYTES:-5242880}"

if [ "$allow_main" = "1" ]; then
  echo "pre-push: PWE_ALLOW_PUSH_MAIN=1，仅跳过 main 保护；大文件检查照跑" >&2
fi

blocked_main=0
blocked_blob=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -z "$remote_ref" ] && continue

  if [ "$remote_ref" = "$protected" ] && [ "$allow_main" != "1" ]; then
    blocked_main=1
    echo "pre-push: 拒绝直推 main（本地 $local_ref -> $remote_ref，提交 $local_sha）" >&2
  fi

  # 第 2 道不因 main 豁免而跳过。删除分支没有新增 blob，直接略过。
  if [ "$local_ref" != "(delete)" ] && [ -n "$local_sha" ]; then
    if [ "$remote_sha" = "$zero" ]; then
      range="$local_sha"
    else
      range="$remote_sha..$local_sha"
    fi
    oversize=$(git rev-list --objects "$range" 2>/dev/null \
      | git cat-file --batch-check='%(objecttype) %(objectsize) %(rest)' 2>/dev/null \
      | awk -v lim="$max_blob" '$1=="blob" && ($2+0)>=lim+0 { printf "    %s bytes  %s\n", $2, $3 }' \
      | head -n 5)
    if [ -n "$oversize" ]; then
      blocked_blob=1
      echo "pre-push: 新增 blob 超过 $max_blob 字节：" >&2
      printf '%s\n' "$oversize" >&2
    fi
  fi
done

if [ "$blocked_blob" -eq 1 ]; then
  cat >&2 <<'MSG'

大文件会永久留在历史里，删除也要重写历史。
  - 证据图/快照请先压缩，或存到仓外再引用；
  - 确需提交时显式放宽（只影响这一次）：
    PWE_PREPUSH_MAX_BLOB_BYTES=<字节数> git push ...
MSG
fi

if [ "$blocked_main" -eq 1 ]; then
  cat >&2 <<'MSG'

main 是受保护分支：请走分支 + PR / merge，不要直接 push。
  1) git switch -c feat/<topic>
  2) git push -u origin feat/<topic>    # 然后开 PR
  3) 由 PR 合入 main

确实需要绕过时（例如恢复灾难现场）：
  PWE_ALLOW_PUSH_MAIN=1 git push origin <ref>:main
  （它只跳过 main 这一条；大文件检查仍会执行）

安装与自检：
  git config core.hooksPath .githooks
  npm run check:hooks
MSG
fi

if [ "$blocked_main" -eq 1 ] || [ "$blocked_blob" -eq 1 ]; then
  exit 1
fi

exit 0
