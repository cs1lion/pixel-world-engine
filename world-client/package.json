{
  "name": "pixel-world-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "像素世界引擎的前端：模拟内核 + 渲染 + HUD",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-types.ts && vite build",
    "build:world": "node scripts/check-types.ts && vite build --base=/world/",
    "preview": "vite preview",
    "check": "node scripts/check-types.ts",
    "test": "node --import ./test/phaser-hooks.mjs --test test/*.test.ts",
    "test:inprocess": "node --import ./test/phaser-hooks.mjs --test --experimental-test-isolation=none test/*.test.ts",
    "audit:ports": "node scripts/audit-ports.ts --strict",
    "red:first": "node scripts/red-first.ts",
    "dev:live": "node scripts/dev-live.mjs",
    "test:live": "node scripts/accept-live.mjs",
    "test:browser": "node scripts/smoke.mjs",
    "test:interact": "node scripts/check-interact.mjs",
    "test:oracle-e2e": "node scripts/check-oracle-e2e.mjs",
    "test:phases": "node scripts/check-phases.mjs",
    "test:persistence": "node scripts/check-persistence.mjs",
    "test:render-budget": "node scripts/check-render-budget.mjs",
    "test:setting": "node scripts/check-dengchao.mjs",
    "test:scene-depth": "node scripts/check-scene-depth.mjs",
    "test:lamp-pool": "node scripts/check-lamp-pool.mjs",
    "test:lamp-band": "node scripts/check-lamp-band.mjs",
    "test:setting-scale": "node scripts/check-setting-scale.mjs",
    "test:buttons": "node scripts/check-buttons.mjs",
    "trace:record": "node scripts/trace-record.ts",
    "trace:replay": "node scripts/trace-replay.ts",
    "trace:test": "node scripts/trace-to-test.ts",
    "fixture:check": "node scripts/fixture-check.ts"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.19.2",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  }
}
